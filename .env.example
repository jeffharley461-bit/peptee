# Copy to `.env` and fill in (gitignored — never commit your real keys).
# Requires Node 20.12+ (uses process.loadEnvFile).

# ── App (public) — used by the frontend via Vite.
# Find at: Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Migrations (required for `npm run db:migrate`) ──────────────────────────
# Full Postgres connection string (NOT the anon key — that cannot run DDL).
# Find at: Supabase Dashboard > Project Settings > Database > Connection string
# E.g. postgresql://postgres.abcdefghijkl:DB-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.YOUR-REF:YOUR-DB-PASSWORD@YOUR-HOST:5432/postgres

# Optional overrides
# DATABASE_URL=            # fallback connection string
# MIGRATIONS_DIR=          # default: supabase/migrations
# MIGRATIONS_TABLE=        # default: _schema_migrations